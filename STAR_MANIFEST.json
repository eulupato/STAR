{
  "name": "STAR",
  "version": "1.9",
  "release_status": "final",
  "release_channel": "stable",
  "mode": "offline-first",
  "entrypoint": "main.py",
  "launcher": "INICIAR_STAR.bat",
  "features_active": [
    "identity",
    "internal_knowledge",
    "router",
    "executive",
    "persistent_memory",
    "visual_menu",
    "chat",
    "avatar",
    "hub",
    "islands",
    "closet_skins",
    "math_engine",
    "computer_commands",
    "local_speech_to_text",
    "official_local_voice",
    "fast_local_tts_fallback",
    "voice_degraded_startup",
    "automatic_spoken_replies",
    "removable_knowledge_packs"
  ],
  "features_prepared": [
    "expanded_automation",
    "messaging_integrations",
    "web_tools",
    "knowledge_expansion",
    "star_mind_v2"
  ],
  "experimental_features": [
    "star_device_gateway_v0_2",
    "star_watch_android_v0_3",
    "star_watch_app_v0_4",
    "star_watch_pc_simulator_v0_4",
    "star_watch_plasma_orbit_ui",
    "star_mobile_ios_v0",
    "adaptive_device_runtime_v0"
  ],
  "star_watch_app": {
    "version": "0.4.0",
    "status": "functional-simulator",
    "product_direction": "watch-first",
    "primary_shell": true,
    "pc_simulator": "clients/star_watch_app.py",
    "launcher": "INICIAR_STAR_WATCH_APP.bat",
    "android_transport_client_version": "0.3.0",
    "hardware_real_required": false,
    "visual_system": {
      "version": "1.0.0",
      "renderer": "clients/star_watch_visual.py",
      "functional_base": "clients/star_watch_app.py",
      "style": "plasma-orbit",
      "procedural": true,
      "asset_dependency": false,
      "target_fps": 30,
      "states": [
        "PRONTA",
        "OUVINDO",
        "PENSANDO",
        "RESPONDENDO",
        "ATENÇÃO"
      ]
    },
    "interaction": {
      "ring_rotate": true,
      "ring_press": true,
      "touch": true,
      "voice": true,
      "pc_mouse_wheel_simulates_ring": true,
      "pc_enter_simulates_ring_press": true
    },
    "modes": [
      "voice",
      "search",
      "health",
      "gps",
      "vision",
      "people",
      "measure",
      "media",
      "weather",
      "settings"
    ]
  },
  "voice": {
    "stt": "faster-whisper tiny local PT-BR",
    "tts_default": "Chatterbox Multilingual local com referência autorizada da STAR",
    "tts_fallback": "Piper pt_BR-faber-medium local; Windows SAPI como último fallback",
    "voice_mode": "official",
    "playback": "sounddevice local",
    "external_voice_services": false,
    "reference_audio": "local-only: resolvida por STAR_VOICE_REFERENCE/config.py/voice/reference/*",
    "silent_fallback_to_generic_voice": false,
    "startup_dependency": false,
    "interface_can_start_without_tts": true,
    "automatic_reply_from_gui": true,
    "fast_mode": "Windows SAPI preferencial + Piper PT-BR fallback"
  },
  "device_gateway": {
    "status": "experimental",
    "enabled_by_default": false,
    "protocol": 1,
    "transport": "LAN HTTP",
    "default_port": 8765,
    "processing_location": "STAR Core no PC"
  },
  "device_ecosystem": {
    "schema": 1,
    "sync_interval_seconds": 30,
    "theme": {
      "background": "#03050A",
      "surface": "#0B1220",
      "primary": "#72E8FF",
      "secondary": "#A276FF",
      "accent": "#FF79C8",
      "text": "#FFFFFF",
      "muted": "#8B96A8"
    },
    "labels": {
      "title": "STAR",
      "pair": "PAREAR",
      "send": "ENVIAR",
      "speak": "FALAR",
      "stop_and_send": "ENVIAR ÁUDIO",
      "camera": "VISÃO",
      "search": "BUSCA",
      "health": "SAÚDE",
      "gps": "GPS",
      "people": "PEOPLE",
      "measure": "MEDIR",
      "media": "MÍDIA",
      "weather": "CLIMA",
      "settings": "CONFIG"
    },
    "features": {
      "text": true,
      "voice_input": true,
      "spoken_reply": true,
      "camera_transport": true,
      "vision_analysis": false,
      "health_transport": false,
      "location_transport": false,
      "ring_navigation": true,
      "ring_press": true,
      "people_local_store": true,
      "measure_provider": "simulated-until-hardware",
      "remote_pc_actions": false
    },
    "profiles": {
      "phone": {
        "layout": "comfortable",
        "show_connection_fields": true,
        "show_response_transcript": true,
        "preferred_columns": 1
      },
      "watch": {
        "layout": "circular-shell",
        "shape": "circle",
        "show_connection_fields": false,
        "show_response_transcript": true,
        "preferred_columns": 1,
        "home_style": "plasma-core-ring",
        "visual_style": "plasma-orbit",
        "screens": [
          "home",
          "voice",
          "search",
          "health",
          "gps",
          "vision",
          "people",
          "measure",
          "media",
          "weather",
          "settings"
        ]
      }
    }
  }
}
