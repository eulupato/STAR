{
  "name": "STAR",
  "version": "1.9",
  "release_status": "final",
  "release_channel": "stable",
  "mode": "offline-first",
  "entrypoint": "main.py",
  "launcher": "INICIAR_STAR.bat",
  "features_active": [
    "identity",
    "internal_knowledge",
    "router",
    "executive",
    "persistent_memory",
    "visual_menu",
    "chat",
    "avatar",
    "hub",
