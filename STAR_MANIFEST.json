    "automatic_spoken_replies",
    "removable_knowledge_packs"
  ],
  "features_prepared": [
    "expanded_automation",
    "messaging_integrations",
    "web_tools",
    "knowledge_expansion",
    "star_mind_v2"
  ],
  "experimental_features": [
    "star_device_gateway_v0_2",
    "star_watch_android_v0",
    "star_mobile_ios_v0",
    "adaptive_device_runtime_v0"
  ],
  "voice": {
    "stt": "faster-whisper tiny local PT-BR",
    "tts_default": "Chatterbox Multilingual local com referência autorizada da STAR",
