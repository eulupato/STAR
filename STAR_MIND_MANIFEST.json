    "integration": "core/star_core.py",
    "cognitive_cycle": ["PERCEBER", "IDENTIFICAR", "COMPREENDER", "CONTEXTUALIZAR", "RELACIONAR", "PREVER", "INTERPRETAR", "DECIDIR", "AGIR", "OBSERVAR", "APRENDER"],
    "models": ["WORLD MODEL", "HUMAN MODEL", "SOCIAL MODEL", "SELF MODEL", "SITUATION MODEL"],
