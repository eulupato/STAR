{
  "name": "STAR MIND",
  "schema": 4,
  "status": "experimental-alpha",
  "host_release": "STAR V1.9 stable",
  "roadmap_alignment": [
    "V2.0 MIND foundation",
    "V2.1 Memory foundation",
    "V2.2 Knowledge Graph foundation",
    "partial V3 Knowledge",
    "partial V3.3 Scientific Engine",
    "partial V5 Senses",
    "partial V7 Guardian/Cura",
    "partial V8 Agent"
  ],
  "principles": [
    "local-first",
    "offline-first",
    "one STAR Core",
    "same official SQLite database",
    "legacy routing preserved",
    "auditable artifacts instead of hidden chain-of-thought",
    "no autonomous sensitive action",
    "no autonomous repository modification",
    "no invented certainty",
    "provenance before growth counters",
    "derived indexes are rebuildable",
    "optional heavy backends never define base startup"
  ],
  "cognitive_catalog": {
    "themes": 15,
    "areas_per_theme": 20,
    "lenses_per_area": 50,
    "canonical_nodes_per_theme": 1000,
    "variants_per_node": 1000,
    "contents_per_theme": 1000000,
    "total_operational_contents": 15000000,
    "materialization": "on-demand",
    "truthfulness_note": "15M are deterministic operational/cognitive support variations, not 15M independently researched facts"
  },
  "persistence": {
    "database": "star.db",
    "engine": "database.database.engine",
    "parallel_database_created": false,
    "important_tables": [
      "cognitive_memory",
      "knowledge_nodes",
      "knowledge_edges",
      "cognitive_projects",
      "cognitive_project_events",
      "cognitive_user_model",
      "cognitive_documents",
      "cognitive_document_chunks",
      "cognitive_evaluations",
      "cognitive_research_sources",
      "cognitive_facts",
      "cognitive_growth_runs",
      "cognitive_goals",
      "cognitive_goal_tasks",
      "cognitive_goal_checkpoints",
      "cognitive_goal_schedule",
      "cognitive_chunk_embeddings",
      "guardian_permissions",
      "guardian_audit_log",
      "guardian_action_claims",
      "operator_files",
      "star_people",
      "star_people_assets"
    ]
  },
  "cognitive_runtime": {
    "engine": "core/cognition_runtime.py",
    "status": "alpha-local",
    "working_context": true,
    "salience": true,
    "model_router": true,
    "registered_engine_selection_only": true,
    "automatic_external_model_discovery": false
  },
  "goal_engine": {
    "engine": "core/goal_engine.py",
    "status": "alpha-local",
    "persistent_goals": true,
    "task_dependencies": true,
    "durable_checkpoints": true,
    "persistent_scheduler": true,
    "priority_ordering": true,
    "background_autonomy": false,
    "idempotent_handler_execution": true,
    "autonomous_sensitive_actions": false
  },
  "guardian": {
    "engine": "core/guardian.py",
    "status": "alpha-local",
    "default_deny_unknown": true,
    "audit_log": true,
    "confirmation_policy": true,
    "idempotent_claims": true,
    "os_grade_sandbox": false,
    "encrypted_secrets_vault": false
  },
  "cure": {
    "engine": "core/cure.py",
    "status": "active-local-guarded-alpha",
    "health_checks": ["python syntax", "JSON validity", "SQLite quick_check", "critical files", "disk warning"],
    "known_good_snapshots": true,
    "watchdog": true,
    "verified_corruption_restore": true,
    "pre_repair_snapshot": true,
    "rollback_if_repair_fails": true,
    "healthy_drift_overwritten": false,
    "github_required": false,
    "generative_code_repair": false,
    "unrestricted_self_modification": false
  },
  "people": {
    "engine": "core/people.py",
    "status": "active-local-alpha",
    "storage": "star.db + runtime/people",
    "explicit_profile_ingestion": true,
    "local_image_assets": true,
    "sha256": true,
    "non_biometric_dhash": true,
    "face_recognition": false,
    "sensitive_trait_inference": false,
    "gps_exif_ingested": false,
    "network_required": false
  },
  "web_knowledge": {
    "engine": "core/web_knowledge.py",
    "status": "active-opt-in-network-alpha",
    "generative_ai": false,
    "providers": ["SearXNG configurable/preferred", "DuckDuckGo HTML fallback"],
    "network_default": false,
    "private_network_ssrf_block": true,
    "deterministic_sentence_ranking": true,
    "provenance_preserved": true,
    "learned_evidence_cached_in_existing_cognitive_store": true,
    "offline_cache_reuse": true,
    "learned_web_content_becomes_absolute_truth": false
  },
  "rag": {
    "source_of_truth": "existing cognitive document tables + FTS5/BM25",
    "plain_pdf_engine": "pypdf",
    "hybrid_semantic_engine": "core/semantic_rag.py",
    "deterministic_hash_embedding_fallback": true,
    "sentence_transformers_optional": true,
    "sqlite_vec_optional_not_active_storage": true,
    "ocr_optional": "PyMuPDF + external Tesseract",
    "heavy_models_loaded_at_startup": false
  },
  "research": {
    "engine": "core/research_hub.py",
    "providers": ["Crossref", "OpenAlex", "arXiv", "PubMed/NCBI"],
    "network_default": false,
    "deduplication": "DOI > URL > normalized title",
    "full_text_download": false,
    "scope": "scholarly discovery/metadata; methodological evidence evaluation remains a separate verification step"
  },
  "knowledge_graph": {
    "store": "existing knowledge_nodes + knowledge_edges",
    "indexer": "core/scientific_graph.py",
    "canonical_scientific_themes": 56,
    "canonical_scientific_concepts": 885,
    "canonical_cultural_subjects": 125,
    "cultural_aspects": 40,
    "cultural_variants_lazy": 5000000,
    "invented_causal_relations": false,
    "theological_truth_inference": false
  },
  "simulation": {
    "engine": "core/scientific_simulation.py",
    "models": [
      "vector RK4",
      "two-body orbit 2D",
      "nonlinear damped pendulum",
      "heat equation 1D",
      "wave equation 1D",
      "RC circuit"
    ],
    "validation_guards": ["orbit energy drift", "heat explicit stability", "wave CFL"],
    "high_fidelity_cfd_fea_spice_numerical_relativity": false
  },
  "operator": {
    "file_index": "core/operator_index.py",
    "status": "alpha-read-only",
    "explicit_indexing": true,
    "background_scan": false,
    "file_writes_or_deletes": false
  },
  "senses": {
    "observation_contract": "core/senses.py",
    "fusion_buffer": true,
    "semantic_scene_understanding": false,
    "multimodal_semantic_fusion": false
  },
  "language_surface": {
    "manifest": "STAR_LANGUAGE_MANIFEST.json",
    "profile_families": 13,
    "locale_profiles": 18,
    "canonical_knowledge_locale": "pt-BR",
    "knowledge_duplicated_per_language": false,
    "historical_modern_mt_claimed": false
  },
  "network_contract": {
    "core_default": "OFFLINE",
    "central_gate": "StarCore.network_enabled",
    "weather_bound_to_same_gate": true,
    "web_knowledge_requires_explicit_online": true,
    "research_hub_requires_explicit_online": true,
    "base_cognition_requires_internet": false
  },
  "cultural_knowledge": {
    "engine": "core/religion_magic_knowledge.py",
    "manifest": "STAR_RELIGION_MAGIC_MANIFEST.json",
    "canonical_nodes": 5000,
    "addressable_study_views": 5000000,
    "supernatural_claims_as_physics": false,
    "restricted_community_knowledge_reconstruction": false
  },
  "self_improvement": {
    "records_metrics": true,
    "recommends_changes": true,
    "autonomous_repository_edits": false,
    "cure_snapshot_repair_is_not_general_self_rewrite": true
  },
  "roadmap_truthfulness": {
    "v2_complete": false,
    "v3_complete": false,
    "v4_complete": false,
    "v5_complete": false,
    "v7_complete": false,
    "v8_complete": false,
    "note": "This manifest describes integrated alpha foundations hosted by the V1.9 stable release; it does not promote future roadmap versions to complete."
  }
}
