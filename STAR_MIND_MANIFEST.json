{
  "name": "STAR MIND",
  "schema": 2,
  "status": "experimental-alpha",
  "host_release": "STAR V1.9 stable",
  "roadmap_alignment": ["V2.0 MIND", "V2.1 Memory", "V2.2 Knowledge Graph", "partial V3 Knowledge", "partial V3.3 Scientific Engine", "partial V7 Guardian", "partial V8 Agent"],
  "principles": [
    "local-first",
    "one STAR Core",
    "same official SQLite database",
    "legacy routing preserved",
    "auditable artifacts instead of hidden chain-of-thought",
    "no autonomous sensitive action",
    "no autonomous repository modification",
    "no invented certainty",
    "provenance before growth counters",
    "derived indexes are rebuildable",
    "optional heavy backends never define base startup"
  ],
  "capabilities": [
    "reasoning",
    "planning",
    "memory",
    "knowledge_graph",
    "scientific_reasoning",
    "mathematics",
    "simulation",
    "coding",
    "verification",
    "document_rag",
    "research",
    "projects",
    "user_model",
    "multi_agent",
    "self_improvement"
  ],
  "cognitive_catalog": {
    "themes": 15,
    "areas_per_theme": 20,
    "lenses_per_area": 50,
    "canonical_nodes_per_theme": 1000,
    "variants_per_node": 1000,
    "contents_per_theme": 1000000,
    "total_operational_contents": 15000000,
    "materialization": "on-demand",
    "truthfulness_note": "15M are deterministic operational/cognitive support variations, not 15M independently researched facts"
  },
  "persistence": {
    "database": "star.db",
    "engine": "database.database.engine",
    "tables": [
      "cognitive_memory",
      "knowledge_nodes",
      "knowledge_edges",
      "cognitive_projects",
      "cognitive_project_events",
      "cognitive_user_model",
      "cognitive_documents",
      "cognitive_document_chunks",
      "cognitive_evaluations",
      "cognitive_research_sources",
      "cognitive_facts",
      "cognitive_growth_runs",
      "cognitive_goals",
      "cognitive_goal_tasks",
      "cognitive_goal_checkpoints",
      "cognitive_chunk_embeddings",
      "guardian_permissions",
      "guardian_audit_log",
      "guardian_action_claims",
      "operator_files"
    ],
    "document_search": "SQLite FTS5/BM25 when available; textual fallback otherwise",
    "parallel_database_created": false
  },
  "cognitive_runtime": {
    "engine": "core/cognition_runtime.py",
    "status": "alpha-local",
    "working_context": true,
    "salience": true,
    "model_router": true,
    "registered_engine_selection_only": true,
    "automatic_external_model_discovery": false
  },
  "math": {
    "engine": "SymPy",
    "features": ["symbolic simplify", "equation solving", "derivatives", "integrals", "numeric evaluation"]
  },
  "simulation": {
    "base_engine": "core/labs.py",
    "advanced_engine": "core/scientific_simulation.py",
    "features": [
      "projectile",
      "exponential dynamics",
      "Monte Carlo",
      "scalar RK4",
      "vector RK4",
      "two-body orbit 2D",
      "nonlinear damped pendulum",
      "heat equation 1D",
      "wave equation 1D",
      "RC circuit"
    ],
    "validation_guards": ["orbit energy drift", "heat explicit stability", "wave CFL"],
    "high_fidelity_cfd_fea_spice_numerical_relativity": false
  },
  "code_lab": {
    "status": "restricted-local",
    "isolated_python_flags": ["-I", "-S"],
    "os_grade_sandbox": false,
    "note": "untrusted code still requires future OS-grade Guardian/Sandbox"
  },
  "rag": {
    "formats": ["txt", "md", "csv", "json", "py", "rst", "pdf"],
    "source_of_truth": "existing cognitive document tables + FTS5/BM25",
    "plain_pdf_engine": "pypdf",
    "hybrid_semantic_engine": "core/semantic_rag.py",
    "deterministic_hash_embedding_fallback": true,
    "sentence_transformers_optional": true,
    "sqlite_vec_optional": true,
    "ocr_optional": "PyMuPDF + external Tesseract",
    "ocr_selective": true,
    "heavy_models_loaded_at_startup": false
  },
  "knowledge_graph": {
    "store": "existing knowledge_nodes + knowledge_edges",
    "curriculum_indexer": "core/scientific_graph.py",
    "canonical_themes": 56,
    "canonical_concepts": 885,
    "taxonomy_derived_relations": true,
    "invented_causal_relations": false,
    "materialization": "explicit/on-demand"
  },
  "research": {
    "engine": "core/research_hub.py",
    "providers": ["Crossref", "OpenAlex", "arXiv", "PubMed/NCBI"],
    "network_default": false,
    "deduplication": "DOI > URL > normalized title",
    "full_text_download": false,
    "scope": "scholarly discovery/metadata; methodological evidence evaluation remains a separate verification step"
  },
  "goal_engine": {
    "engine": "core/goal_engine.py",
    "status": "alpha-local",
    "persistent_goals": true,
    "task_dependencies": true,
    "durable_checkpoints": true,
    "idempotent_handler_execution": true,
    "autonomous_sensitive_actions": false
  },
  "guardian": {
    "engine": "core/guardian.py",
    "status": "alpha-local",
    "default_deny_unknown": true,
    "audit_log": true,
    "confirmation_policy": true,
    "idempotent_claims": true,
    "os_grade_sandbox": false,
    "encrypted_secrets_vault": false
  },
  "operator": {
    "file_index": "core/operator_index.py",
    "status": "alpha-read-only",
    "explicit_indexing": true,
    "background_scan": false,
    "file_writes_or_deletes": false
  },
  "senses": {
    "observation_contract": "core/senses.py",
    "fusion_buffer": true,
    "semantic_scene_understanding": false,
    "multimodal_semantic_fusion": false
  },
  "user_model": {
    "policy": "explicit and auditable",
    "automatic_sensitive_trait_inference": false
  },
  "self_improvement": {
    "records_metrics": true,
    "recommends_changes": true,
    "autonomous_repository_edits": false
  },
  "daily_growth": {
    "requested_target_per_theme": 1000000,
    "target_is_guarantee": false,
    "accepted_definition": "unique record with content, source and source_type/provenance",
    "duplicates_count_as_new": false,
    "rejected_records_count_as_new": false,
    "deterministic_variants_count_as_new_facts": false
  }
}
