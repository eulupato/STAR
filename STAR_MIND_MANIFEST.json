      "claims_and_evidence": "BLOCO 2 epistemic ledger",
      "knowledge_graph": "existing knowledge_nodes/knowledge_edges",
      "identity_and_core": "existing STAR Core",
      "parallel_graph_created": false,
      "parallel_database_created": false
    },
    "indexing": {
      "exact": ["canonical normalized label", "alias", "facet"],
      "full_text": "SQLite FTS5/BM25 when available",
      "fallback": "indexed/textual SQLite lookup",
      "cache": "bounded in-memory LRU/TTL with invalidation on writes",
      "cache_is_source_of_truth": false
    },
    "deduplication": "stable identity from namespace + knowledge type + normalized canonical label; duplicate canonical registrations reuse the same object and link additional claims",
    "namespace_capacity": {
      "per_namespace_addressable_contents": 1000000000,
      "independent_namespaces": true,
      "current_namespaces": ["B01", "B02", "B03", "B04"],
      "future_blocks_can_register_without_schema_change": true,
      "id_storage": "TEXT",
      "materialization": "on-demand",
      "truthfulness_note": "each 1B is logical capacity per block namespace, not a billion preloaded rows; integrated B01-B04 therefore represent 4B logical addresses with only materialized knowledge persisted"
    },
    "block_3_catalog": {
      "canonical_areas": 20,
      "lenses_per_area": 50,
      "canonical_nodes": 1000,
      "variants_per_node": 1000000,
      "addressable_contents": 1000000000,
      "materialization": "on-demand",
      "prepopulated_knowledge_rows": 0
    }
  },
