<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>A STAR usa a rede local para conectar este iPhone ao STAR Core no seu PC.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>O microfone envia comandos de voz ao STAR Core no seu PC.</string>
    <key>NSCameraUsageDescription</key>
    <string>A câmera é usada para visão e, em aparelhos compatíveis, para medição física com profundidade real.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>A biblioteca pode ser usada como alternativa de imagem quando a câmera não estiver disponível.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>O GPS fornece localização real à STAR somente enquanto os sensores estiverem ativos no app.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>A STAR lê medições de saúde autorizadas, como frequência cardíaca, para contexto pessoal local.</string>
    <key>NSMotionUsageDescription</key>
    <string>A STAR usa acelerômetro e giroscópio para compreender movimento e orientação do dispositivo.</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
</dict>
</plist>
