{
  "schema": 2,
  "status": "active-local",
  "default_locale": "pt-BR",
  "canonical_content_locale": "pt-BR",
  "language_families": 5,
  "locale_profiles": ["pt-BR", "en-US", "en-GB", "es-ES", "it-IT", "fr-FR"],
  "expression_contents_per_family": 100000,
  "total_semantic_expression_contents": 500000,
  "english_surface_variants": 2,
  "translation_policy": "canonical-content + localized-surface + contextual-equivalence-before-literal",
  "global_localization": {
    "engine": "core/global_localization.py",
    "manager": "core/language_manager.py",
    "desktop_ui": "gui/localized_app.py",
    "strict_no_partial_translation": true,
    "protected_invariants": ["content_ids", "numbers_and_units", "urls", "emails", "filesystem_paths", "inline_code", "code_blocks", "math_delimiters"],
    "static_ui_localization": true,
    "core_input_translation": true,
    "core_output_translation": true,
    "watch_localization": true,
    "desktop_ui_localization": true,
    "desktop_response_localization": true,
    "source_of_truth_policy": "knowledge and cognition are stored once; translations are presentation surfaces only"
  },
  "dictionary_runtime": "SQLite local + compact seed fallback",
  "dictionary_sources_minimum_per_family": 5,
  "full_dictionary_materialization": "one-time build from open source snapshots; runtime lookup is offline",
  "neural_translation": {
    "backend": "Argos Translate",
    "status": "optional-local",
    "required_for_star_startup": false,
    "automatic_download_on_startup": false,
    "requirements": "requirements-translation.txt",
    "setup_script": "scripts/setup_offline_translation.py",
    "minimum_pairs": ["pt->en", "en->pt", "es->en", "en->es", "it->en", "en->it", "fr->en", "en->fr"],
    "pivot_language": "en",
    "fallback_policy": "if a complete translation cannot be produced safely, preserve the original content instead of mixing languages or inventing text"
  },
  "watch": {
    "mode": "language",
    "renderer": "clients/star_watch_language.py",
    "selection": "STAR Ring left/right",
    "flags": true,
    "voice_commands": true,
    "plasma_orbit_preserved": true,
    "same_language_manager_as_core": true
  },
  "packs": [
    "knowledge/languages/pt_br/language_pack.json",
    "knowledge/languages/en/language_pack.json",
    "knowledge/languages/es/language_pack.json",
    "knowledge/languages/it/language_pack.json",
    "knowledge/languages/fr/language_pack.json"
  ]
}
